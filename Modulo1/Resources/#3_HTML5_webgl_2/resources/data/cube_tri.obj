# Triangulated cube with per-face materials
mtllib cube_tri.mtl

v -0.5 -0.5 -0.5
v  0.5 -0.5 -0.5
v  0.5  0.5 -0.5
v -0.5  0.5 -0.5
v -0.5 -0.5  0.5
v  0.5 -0.5  0.5
v  0.5  0.5  0.5
v -0.5  0.5  0.5

# Bottom (-Z)
usemtl Red
f 1 2 3
f 1 3 4

# Top (+Z)
usemtl Green
f 5 6 7
f 5 7 8

# Left (-X)
usemtl Blue
f 1 5 8
f 1 8 4

# Right (+X)
usemtl Yellow
f 2 6 7
f 2 7 3

# Front (+Y)
usemtl Magenta
f 4 3 7
f 4 7 8

# Back (-Y)
usemtl Cyan
f 1 2 6
f 1 6 5
